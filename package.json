{
  "name": "finca-control",
  "private": true,
  "version": "2.1.2",
  "description": "Sistema de gestión agrícola y ganadera.",
  "author": "Oscar David Vega Daza",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/check-rollup-platform.cjs && vite",
    "build": "node scripts/check-rollup-platform.cjs && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "electron:dev": "cross-env ELECTRON_START_URL=http://localhost:5173 concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "clean:electron": "node scripts/clean-electron.cjs",
    "build:electron": "npm run clean:electron && node scripts/build-windows.cjs",
    "build:windows": "node scripts/build-windows.cjs"
  },
  "dependencies": {
    "docx": "^9.15.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.344.0",
    "primeicons": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.finca.ganaderia",
    "productName": "FincaControl",
    "disableAsarIntegrity": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "build_windows"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "legalTrademarks": "Finca Control",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerHeader": "electron/installer-header.bmp",
      "installerSidebar": "electron/installer-sidebar.bmp",
      "uninstallerSidebar": "electron/installer-sidebar.bmp",
      "include": "electron/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Finca Control",
      "deleteAppDataOnUninstall": false
    }
  }
}
